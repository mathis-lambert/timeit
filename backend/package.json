{
  "name": "@timeit/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:native": "node --import tsx test/native-contract.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts",
    "test:public-native": "node --import tsx test/public-native-contract.ts"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.41",
    "decimal.js": "^10.6.0",
    "fastify": "^5.6.1",
    "jose": "^6.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
