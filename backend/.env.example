HOST=127.0.0.1
PORT=4318
# Cloud routes are disabled by default. This opt-in is only for local integration tests;
# production rejects CLOUD_ENABLED=true until the cloud service is ready.
CLOUD_ENABLED=false
DATABASE_URL=postgres://timeit:timeit@127.0.0.1:54329/timeit
# Development auth only works on loopback and is rejected in production.
DEV_AUTH=true
# The future cloud service requires all three values. Register a public native OIDC client
# with Authorization Code + PKCE and redirect fr.mathislambert.timeit:/oauth/callback.
# OIDC_ISSUER=https://auth.mathislambert.fr/realms/timeit
# OIDC_AUDIENCE=timeit-api
# OIDC_CLIENT_ID=timeit-macos
